rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if requesting user is authorized Admin
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Admin collection in admins/{uid}
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == adminId;
      allow update, delete: if request.auth != null && (request.auth.uid == adminId || isAdmin());
    }
    
    // User accounts in users/{uid}
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Provider profile in providers/{uid}
    match /providers/{providerId} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.auth.uid == providerId || isAdmin());
    }
    
    // Provider KYC documents in providerKyc/{uid}
    match /providerKyc/{providerId} {
      allow read, write: if request.auth != null && (request.auth.uid == providerId || isAdmin());
    }
    
    // Services / Master Services collection
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete, write: if request.auth != null;
    }
    
    // Service Provider Availability entries in providerServices/{id}
    match /providerServices/{id} {
      allow read: if true;
      allow create, update, delete, write: if request.auth != null;
    }
    
    // Bookings between customers and providers
    match /bookings/{bookingId} {
      allow read: if request.auth != null 
        && (resource.data.userId == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null 
        && (resource.data.userId == request.auth.uid || resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Withdrawal requests
    match /withdrawals/{withdrawalId} {
      allow read: if request.auth != null && (resource.data.providerId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.providerId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.providerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
